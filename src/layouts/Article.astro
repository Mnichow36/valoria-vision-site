---
import Base from './Base.astro';
import { SITE } from '../data/site.js';
const { frontmatter } = Astro.props;
const f = frontmatter;
const dateAffichee = new Date(f.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: f.title,
  description: f.description,
  datePublished: f.date,
  dateModified: f.modifie || f.date,
  inLanguage: 'fr-FR',
  author: { '@type': 'Organization', name: SITE.studio },
  publisher: { '@type': 'Organization', name: SITE.studio },
  mainEntityOfPage: new URL(Astro.url.pathname.replace(/\.html$/, ''), SITE.url).href,
};
---
<Base titre={f.title} description={f.description} typeOg="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <article class="section" style="padding-top: 72px">
    <div class="conteneur article pile" style="gap: 22px">
      <a href="/blog" class="lien-fleche" style="font-size: 15px">← Le blog</a>
      <p class="chapeau">{f.categorie}</p>
      <h1 style="font-size: clamp(2rem, 4vw, 2.8rem)">{f.title}</h1>
      <p class="intro">{f.chapeau}</p>
      <div class="meta-article">
        <time datetime={f.date}>Publié le {dateAffichee}</time>
        <span>Lecture : {f.lecture} min</span>
      </div>
      {f.motsCles && <ul class="mots-cles" aria-label="Thèmes">{f.motsCles.map((m: string) => <li>{m}</li>)}</ul>}
      {f.miseAJour && (
        <div class="encadre encadre--maj"><p class="texte"><strong style="color: var(--blanc)">Mise à jour du {f.miseAJour.date}.</strong> {f.miseAJour.texte}</p></div>
      )}
      <div class="contenu-article">
        <slot />
      </div>
      <div class="encadre" style="margin-top: 24px; padding: 26px">
        <p class="chapeau" style="margin-bottom: 8px">Bêta privée</p>
        <p style="font-size: 1.25rem; font-weight: 700; color: var(--blanc); margin-bottom: 8px">Vous voulez tester un outil financier local et lisible ?</p>
        <p class="texte" style="margin-bottom: 16px">Rejoignez la liste de la bêta privée pour suivre les avancées et être invité aux premiers tests.</p>
        <div class="actions"><a href="/inscription" class="bouton">Rejoindre la bêta privée</a><a href="/ecrans" class="bouton bouton--contour">Voir les écrans</a></div>
      </div>
    </div>
  </article>
</Base>
<style>
  .contenu-article :global(h2) { font-size: 1.6rem; margin: 2.2rem 0 0.8rem; }
  .contenu-article :global(h3) { margin: 1.6rem 0 0.6rem; }
  .contenu-article :global(p), .contenu-article :global(li) { color: var(--texte-2); }
  .contenu-article :global(ul) { padding-left: 1.2rem; }
  .contenu-article :global(li) { margin: 0.4rem 0; }
  .contenu-article :global(strong) { color: var(--blanc); }
</style>
