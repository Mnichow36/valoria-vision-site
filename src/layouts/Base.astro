---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loupe from '../components/Loupe.astro';
import { SITE } from '../data/site.js';

interface Props {
  titre: string;
  // Titre de l'onglet et de Google, quand le titre de la page est trop long (60 caractères au plus)
  titreSeo?: string;
  description?: string;
  // Image de partage (LinkedIn, Facebook) : JPG 1200 × 630, dans public/images/partage/
  image?: string;
  imageAlt?: string;
  typeOg?: string;
  // true pour les pages à ne pas référencer (page 404)
  noindex?: boolean;
}
const {
  titre,
  titreSeo,
  description = SITE.description,
  image = '/images/partage/tableau-de-bord.jpg',
  imageAlt = 'Tableau de bord de Valoria Vision : cash disponible, patrimoine net, dépenses du mois et alertes.',
  typeOg = 'website',
  noindex = false,
} = Astro.props;
const titreComplet = titreSeo ?? (titre === SITE.nom ? `${SITE.nom} — ${SITE.slogan}` : `${titre} — ${SITE.nom}`);
const canonique = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), SITE.url).href;
const imageAbsolue = new URL(image, SITE.url).href;
// Identité du site pour les moteurs de recherche, sur toutes les pages
const identite = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organisation`,
      name: SITE.nom,
      url: SITE.url,
      logo: `${SITE.url}/images/logo-valoria-vision.png`,
      slogan: SITE.slogan,
      sameAs: [SITE.linkedin],
      founder: { '@type': 'Person', '@id': `${SITE.url}/#fondateur`, name: SITE.auteur.nom, url: new URL(SITE.auteur.page, SITE.url).href },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#site`,
      name: SITE.nom,
      url: SITE.url,
      inLanguage: 'fr-FR',
      publisher: { '@id': `${SITE.url}/#organisation` },
    },
  ],
};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titreComplet}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonique} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#071a3a" />
  <meta property="og:type" content={typeOg} />
  <meta property="og:site_name" content={SITE.nom} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:title" content={titreComplet} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonique} />
  <meta property="og:image" content={imageAbsolue} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(identite)} />
  <slot name="head" />
</head>
<body>
  <a href="#contenu" class="lien-evitement">Aller au contenu</a>
  <Header />
  <main id="contenu">
    <slot />
  </main>
  <Footer />
  <Loupe />
</body>
</html>
