---
import Base from '../layouts/Base.astro';
import EnTete from '../components/EnTete.astro';
const modules = import.meta.glob('./blog/*.md', { eager: true }) as Record<string, any>;
const articles = Object.entries(modules)
  .map(([chemin, m]) => ({ ...m.frontmatter, href: '/blog/' + chemin.split('/').pop()!.replace(/\.md$/, '') }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
const formater = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base titre="Blog" description="Articles Valoria Vision sur les finances personnelles, le patrimoine, le budget, la sécurité locale et la construction du produit.">
  <EnTete chapeau="Blog" titre="Les choix qui construisent Valoria Vision." intro="Sécurité locale, budget, patrimoine, recette, conception et feuille de route : les décisions derrière l’application, expliquées simplement.">
    <a slot="visuel" href={articles[0].href} class="carte carte-article" style="padding: 30px; gap: 14px">
      <p class="chapeau">À la une · {articles[0].categorie}</p>
      <h2 style="font-size: 1.5rem; line-height: 1.3">{articles[0].title}</h2>
      <p>{articles[0].description}</p>
      <span class="lien-fleche">Lire l’article →</span>
    </a>
  </EnTete>
  <section class="section section--alt">
    <div class="conteneur">
      <div class="grille grille--2">
        {articles.slice(1).map((a) => (
          <a href={a.href} class="carte carte-article">
            <p class="chapeau">{a.categorie}</p>
            <h2 style="font-size: 1.2rem; line-height: 1.35">{a.title}</h2>
            <p>{a.description}</p>
            <p class="petit"><time datetime={a.date}>{formater(a.date)}</time> · {a.lecture} min de lecture</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
