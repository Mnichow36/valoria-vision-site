---
import Base from '../layouts/Base.astro';
const modules = import.meta.glob('./blog/*.md', { eager: true }) as Record<string, any>;
const articles = Object.entries(modules)
  .map(([chemin, m]) => ({ ...m.frontmatter, href: '/blog/' + chemin.split('/').pop()!.replace(/\.md$/, '') }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
const formater = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base titre="Blog" description="Articles Valoria Vision sur les finances personnelles, le patrimoine, le budget, la sécurité locale et la construction du produit.">
  <section class="section" style="padding-top: 88px">
    <div class="conteneur pile pile--large">
      <div class="entete-section">
        <p class="chapeau">Blog</p>
        <h1>Les choix qui construisent Valoria Vision.</h1>
        <p class="intro">Sécurité locale, budget, patrimoine, recette, conception et feuille de route : les décisions derrière l’application, expliquées simplement.</p>
      </div>
      <div class="grille grille--2">
        {articles.map((a) => (
          <a href={a.href} class="carte carte-article">
            <p class="chapeau">{a.categorie}</p>
            <h2 style="font-size: 1.2rem; line-height: 1.35">{a.title}</h2>
            <p>{a.description}</p>
            <p class="petit"><time datetime={a.date}>{formater(a.date)}</time> · {a.lecture} min de lecture</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
