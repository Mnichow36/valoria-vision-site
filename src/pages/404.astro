---
import Base from '../layouts/Base.astro';
---
<Base noindex titre="Page introuvable" description="Cette page n’existe pas ou a été déplacée.">
  <section class="section" style="padding-top: 120px; padding-bottom: 140px">
    <div class="conteneur entete-section">
      <p class="chapeau">Erreur 404</p>
      <h1>Cette page n’existe pas.</h1>
      <p class="intro">Elle a peut-être été déplacée. Voici de quoi repartir.</p>
      <div class="actions"><a href="/" class="bouton">Retour à l’accueil</a><a href="/blog" class="bouton bouton--contour">Le blog</a></div>
    </div>
  </section>
</Base>
