---
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import { SITE, MENU, BETA } from '../data/site.js';
const chemin = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const estActif = (href: string) => {
  const cible = href.split('#')[0];
  return cible === chemin || (cible !== '/' && chemin.startsWith(cible + '/'));
};
---
<header class="entete">
  <div class="conteneur entete__barre">
    <a href="/" class="marque" aria-label="Valoria Vision, accueil">
      <Logo taille={40} />
      <span class="marque__textes">
        <span class="marque__nom">{SITE.nom}</span>
        <span class="marque__slogan">VOIR VENIR. DÉCIDER JUSTE.</span>
      </span>
    </a>

    <button class="bouton-menu" type="button" aria-expanded="false" aria-controls="navigation" data-bouton-menu>
      <span class="bouton-menu__ouvrir"><Icone nom="menu" taille={24} /></span>
      <span class="bouton-menu__fermer"><Icone nom="fermer" taille={24} /></span>
      <span class="visuellement-cache">Menu</span>
    </button>

    <nav id="navigation" class="nav" aria-label="Navigation principale" data-nav>
      <ul class="nav__liste">
        {MENU.map((entree, i) => (
          entree.liens ? (
            <li class="nav__groupe" data-groupe>
              <button type="button" class:list={['nav__declencheur', { 'est-actif': entree.liens.some((l) => estActif(l.href)) }]} aria-expanded="false" aria-controls={`sous-menu-${i}`} data-declencheur>
                {entree.titre}<Icone nom="chevron" taille={14} epaisseur={2.5} />
              </button>
              <div class="sous-menu" id={`sous-menu-${i}`} data-sous-menu>
                <ul class="sous-menu__liens">
                  {entree.liens.map((lien) => (
                    <li>
                      <a href={lien.href} class="sous-menu__lien" aria-current={estActif(lien.href) ? 'page' : undefined}>
                        <span class="sous-menu__icone"><Icone nom={lien.icone} taille={22} couleur="#8fe3d4" /></span>
                        <span><strong>{lien.titre}</strong><span>{lien.texte}</span></span>
                      </a>
                    </li>
                  ))}
                </ul>
                <div class="sous-menu__encart">
                  <span class="sous-menu__chapeau">Bêta privée · {BETA.cibleCourte}</span>
                  <strong>Testez Valoria Vision parmi les premiers.</strong>
                  <a href="/inscription" class="bouton bouton--petit">Rejoindre la bêta privée</a>
                </div>
              </div>
            </li>
          ) : (
            <li><a href={entree.href} class:list={['nav__lien', { 'est-actif': estActif(entree.href) }]} aria-current={estActif(entree.href) ? 'page' : undefined}>{entree.titre}</a></li>
          )
        ))}
      </ul>
      <a href="/inscription" class="bouton bouton--petit nav__cta">Rejoindre la bêta privée</a>
    </nav>
  </div>
</header>

<style>
  .entete { position: sticky; top: 0; z-index: 50; background: var(--fond); border-bottom: 1px solid var(--bord-doux); }
  .entete__barre { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 76px; }
  .marque { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--blanc); flex: 0 0 auto; }
  .marque__textes { display: flex; flex-direction: column; gap: 2px; }
  .marque__nom { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }
  .marque__slogan { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; color: var(--texte-3); }

  .nav { display: flex; align-items: center; gap: 18px; }
  .nav__liste { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav__declencheur, .nav__lien {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px; border: 0; border-radius: 10px;
    background: transparent; color: var(--texte); font: inherit; font-size: 15px; font-weight: 500; text-decoration: none; cursor: pointer;
  }
  .nav__declencheur:hover, .nav__lien:hover, .nav__declencheur[aria-expanded='true'] { background: var(--carte-2); color: var(--blanc); }
  .nav__declencheur[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .est-actif { color: var(--blanc); box-shadow: inset 0 -2px 0 var(--ambre); }
  .nav__groupe { position: static; }

  .sous-menu {
    display: none; position: absolute; left: 50%; transform: translateX(-50%); top: calc(100% + 1px);
    width: min(var(--largeur) - 48px, calc(100vw - 32px)); background: var(--carte); border: 1px solid var(--bord);
    border-radius: 0 0 18px 18px; padding: 24px; gap: 24px; box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
  }
  .sous-menu.est-ouvert { display: flex; }
  .sous-menu__liens { flex: 2 1 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; list-style: none; margin: 0; padding: 0; }
  .sous-menu__lien { display: flex; gap: 14px; align-items: flex-start; padding: 14px 16px; border-radius: 12px; text-decoration: none; }
  .sous-menu__lien:hover, .sous-menu__lien[aria-current='page'] { background: var(--carte-2); }
  .sous-menu__lien strong { display: block; color: var(--blanc); font-size: 16px; }
  .sous-menu__lien span span, .sous-menu__lien > span:last-child > span { display: block; color: var(--texte-2); font-size: 14px; line-height: 1.45; }
  .sous-menu__icone { flex: 0 0 auto; margin-top: 2px; }
  .sous-menu__encart { flex: 1 1 0; background: var(--fond); border: 1px solid var(--bord); border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 12px; }
  .sous-menu__encart strong { color: var(--blanc); font-size: 19px; line-height: 1.3; }
  .sous-menu__encart .bouton { margin-top: auto; }
  .sous-menu__chapeau { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ambre-texte); }

  .bouton-menu { display: none; }
  .visuellement-cache { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 1080px) {
    .bouton-menu {
      display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 10px;
      border: 1px solid var(--bord-fort); background: transparent; color: var(--blanc); cursor: pointer;
    }
    .bouton-menu__fermer { display: none; }
    .bouton-menu[aria-expanded='true'] .bouton-menu__ouvrir { display: none; }
    .bouton-menu[aria-expanded='true'] .bouton-menu__fermer { display: inline-flex; }
    .nav {
      display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; align-items: stretch; gap: 16px;
      background: var(--fond); border-bottom: 1px solid var(--bord-doux); padding: 12px 16px 24px; max-height: calc(100vh - 76px); overflow-y: auto;
    }
    .nav.est-ouverte { display: flex; }
    .nav__liste { flex-direction: column; align-items: stretch; }
    .nav__declencheur, .nav__lien { width: 100%; justify-content: space-between; font-size: 17px; }
    .sous-menu { position: static; transform: none; width: auto; border-radius: 12px; box-shadow: none; padding: 8px; margin: 4px 0 8px; }
    .sous-menu.est-ouvert { display: block; }
    .sous-menu__liens { grid-template-columns: 1fr; }
    .sous-menu__encart { display: none; }
    .est-actif { box-shadow: none; }
  }
</style>

<script>
  const boutonMenu = document.querySelector('[data-bouton-menu]');
  const nav = document.querySelector('[data-nav]');
  const groupes = Array.from(document.querySelectorAll('[data-groupe]'));

  function fermerGroupes(sauf) {
    groupes.forEach((g) => {
      if (g === sauf) return;
      g.querySelector('[data-declencheur]')?.setAttribute('aria-expanded', 'false');
      g.querySelector('[data-sous-menu]')?.classList.remove('est-ouvert');
    });
  }

  groupes.forEach((groupe) => {
    const declencheur = groupe.querySelector('[data-declencheur]');
    const sousMenu = groupe.querySelector('[data-sous-menu]');
    declencheur?.addEventListener('click', () => {
      const ouvert = declencheur.getAttribute('aria-expanded') === 'true';
      fermerGroupes(groupe);
      declencheur.setAttribute('aria-expanded', String(!ouvert));
      sousMenu?.classList.toggle('est-ouvert', !ouvert);
    });
  });

  boutonMenu?.addEventListener('click', () => {
    const ouvert = boutonMenu.getAttribute('aria-expanded') === 'true';
    boutonMenu.setAttribute('aria-expanded', String(!ouvert));
    nav?.classList.toggle('est-ouverte', !ouvert);
    if (ouvert) fermerGroupes();
  });

  document.addEventListener('click', (e) => {
    const cible = e.target;
    if (cible instanceof Node && !groupes.some((g) => g.contains(cible)) && window.innerWidth > 1080) fermerGroupes();
  });

  // Un clic sur un lien du menu (y compris vers une section de la même page) referme tout.
  function toutFermer() {
    fermerGroupes();
    boutonMenu?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('est-ouverte');
  }
  nav?.querySelectorAll('a').forEach((lien) => lien.addEventListener('click', toutFermer));
  // Retour arrière du navigateur : la page revient avec les menus fermés.
  window.addEventListener('pageshow', toutFermer);
  // En faisant défiler la page, un sous-menu resté ouvert se referme (ordinateur).
  window.addEventListener('scroll', () => { if (window.innerWidth > 1080) fermerGroupes(); }, { passive: true });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const ouvert = groupes.find((g) => g.querySelector('[data-declencheur]')?.getAttribute('aria-expanded') === 'true');
    fermerGroupes();
    (ouvert?.querySelector('[data-declencheur]') as HTMLElement | null)?.focus();
  });
</script>
