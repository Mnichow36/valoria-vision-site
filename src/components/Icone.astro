  plume: '<path d="M20 4c-7 0-12 5-12 12v4"/><path d="M8 16h6"/><path d="M20 4c0 7-4 11-9 12"/>',
  drapeau: '<path d="M5 21V4"/><path d="M5 4h11l-2 4 2 4H5"/>',
  message: '<path d="M4 5h16v11H8l-4 4z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
