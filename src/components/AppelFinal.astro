---
import FormulaireBeta from './FormulaireBeta.astro';
import Reseaux from './Reseaux.astro';
interface Props { titre?: string; texte?: string }
const { titre = 'Voir venir commence ici.', texte = 'Inscrivez-vous pour suivre la construction et recevoir l’invitation à la bêta privée.' } = Astro.props;
---
<section class="section section--alt" id="beta" aria-labelledby="titre-appel">
  <div class="conteneur duo">
    <div class="pile">
      <h2 id="titre-appel" style="font-size: clamp(2rem, 3.6vw, 2.7rem); font-weight: 800">{titre}</h2>
      <p class="intro">{texte}</p>
      <Reseaux />
    </div>
    <FormulaireBeta id="formulaire-appel" />
  </div>
</section>
